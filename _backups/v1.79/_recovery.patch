+@router.get("/dev-login")
+async def dev_login(request: Request, db: AsyncSession = Depends(get_session)):
+    """Dev-only: quick login without EVE SSO. Only active when DEBUG=true."""
+    if not settings.debug:
+        raise HTTPException(status_code=404, detail="Not available")
+
+    # Use fixed dev IDs
+    DEV_USER_ID = 999001
+    DEV_CHAR_ID = 2112000000
+    DEV_CHAR_NAME = "Dev Tester"
+
+    # Ensure dev user exists in DB (some queries expect it)
+    from app.models.user import User
+    from app.models.character import Character
+
+    # Find or create dev user
+    stmt_u = select(User).where(User.id == DEV_USER_ID)
+    result_u = await db.execute(stmt_u)
+    user = result_u.scalar_one_or_none()
+    if not user:
+        user = User(id=DEV_USER_ID, display_name="Dev Tester")
+        db.add(user)
+        await db.flush()
+
+    # Find or create dev character
+    stmt_c = select(Character).where(Character.character_id == DEV_CHAR_ID)
+    result_c = await db.execute(stmt_c)
+    char = result_c.scalar_one_or_none()
+    if not char:
+        char = Character(
+            character_id=DEV_CHAR_ID,
+            character_name=DEV_CHAR_NAME,
+            user_id=DEV_USER_ID,
+            is_active=True,
+            corporation_id=1,
+            corporation_name="Dev Corp",
+            access_token="",
+            refresh_token="",
+            token_expires_at=datetime(2030, 1, 1, tzinfo=timezone.utc),
+            owner_hash="dev-hash",
+        )
+        db.add(char)
+        await db.flush()
+
+    await db.commit()
+
+    # Set session
+    request.session["user_id"] = DEV_USER_ID
+    request.session["character_id"] = DEV_CHAR_ID
+    request.session["character_name"] = DEV_CHAR_NAME
+
+    logger.info("Dev login: user=%s char=%s (%s)", DEV_USER_ID, DEV_CHAR_ID, DEV_CHAR_NAME)
+    return RedirectResponse(url="/blueprints", status_code=302)
+
+
 @router.get("/logout")
 async def logout(request: Request):
     """Clear session and redirect to login page."""
diff --git a/backend/app/routers/blueprints.py b/backend/app/routers/blueprints.py
index 47dc748..218dcea 100644
--- a/backend/app/routers/blueprints.py
+++ b/backend/app/routers/blueprints.py
@@ -2778,3 +2778,403 @@ async def set_user_price(
 
     await db.commit()
     return {"success": True, "action": "updated" if existing else "created"}
+
+
+# ═══════════════════════════════════════════════════════════════
+#  PHASE B — RECURSIVE TREE COST API
+# ═══════════════════════════════════════════════════════════════
+
+class OrderItemNode(BaseModel):
+    """A single item in an order tree, possibly with sub-components."""
+    blueprint_type_id: int
+    product_type_id: Optional[int] = None
+    product_name: Optional[str] = None
+    runs: int = 1
+    me: int = 10
+    te: int = 20
+    decision: str = "buy"  # "buy" | "build"
+    buy_price: Optional[float] = None
+    config: Optional[FacilityConfig] = None
+    sub_components: List["OrderItemNode"] = []
+
+
+class CostBreakdown(BaseModel):
+    """Cost breakdown for one build step."""
+    material_cost: float = 0
+    job_cost: float = 0
+    facility_tax: float = 0
+    scc_surcharge: float = 0
+    step_total: float = 0      # material + job + tax + scc for THIS step
+    component_total: float = 0  # step_total + sum of sub-components
+    buy_cost: float = 0         # market buy price if decision="buy"
+
+
+class TimeBreakdown(BaseModel):
+    """Build time breakdown for one step."""
+    raw_seconds: int = 0         # Base manufacturing time per run from SDE
+    adjusted_seconds: int = 0    # With skills/implants/rigs per run
+    total_seconds: int = 0       # × runs
+
+
+class CostItemNode(BaseModel):
+    """Enriched tree node with costs, build time, and materials."""
+    blueprint_type_id: int
+    product_type_id: Optional[int] = None
+    product_name: Optional[str] = None
+    runs: int = 1
+    me: int = 10
+    te: int = 20
+    decision: str = "buy"
+    buy_price: Optional[float] = None
+    is_buildable: bool = False
+    has_sub_steps: bool = False
+    depth: int = 0
+    costs: CostBreakdown = CostBreakdown()
+    time: TimeBreakdown = TimeBreakdown()
+    sub_components: List["CostItemNode"] = []
+    materials: List[dict] = []
+
+
+class TreeCostRequest(BaseModel):
+    """Request body for the tree-cost endpoint."""
+    items: List[OrderItemNode]
+    facility: Optional[FacilityConfig] = None
+    skills: Optional[SkillConfig] = None
+    character_id: int = 0
+    implants: Optional[dict] = None
+    use_buy_prices: bool = False
+
+
+class TreeCostResponse(BaseModel):
+    """Response from the tree-cost endpoint."""
+    items: List[CostItemNode]
+    totals: CostBreakdown = CostBreakdown()
+    total_build_time_seq: int = 0   # sequential (1 slot)
+    total_build_time_par: int = 0   # parallel (max per depth level)
+    max_depth: int = 0
+
+
+@router.post("/tree-cost")
+async def calculate_tree_cost(
+    body: TreeCostRequest,
+    _user: int = Depends(require_auth),
+    db: AsyncSession = Depends(get_session),
+):
+    """
+    Calculate full recursive build cost for an order tree.
+
+    Takes a tree of OrderItemNodes (each can have sub_components with their own
+    BUILD/BUY decisions, ME/TE, and StationConfig). Returns enriched nodes with
+    cost breakdowns, build times, and materials per level.
+
+    Cost propagation (bottom-up):
+      BUILD node: component_total = step_total + Σ(sub.component_total)
+      BUY node:   component_total = buy_price × runs
+    """
+    import math
+
+    facility = body.facility or FacilityConfig()
+    skills = body.skills or SkillConfig()
+
+    # ── Helper: Calculate time multiplier from skills ──
+    def _time_multiplier() -> float:
+        """Calculate combined build time multiplier from skills + implants + rigs."""
+        mult = 1.0
+        # Skills (Industry skill -5% per level → max -25%)
+        mult *= (1.0 - min(skills.industry * 0.05, 0.25))
+        # Advanced Industry -4% per level → max -20%
+        mult *= (1.0 - min(skills.advanced_industry * 0.04, 0.20))
+        # Mass Production -5% per level → max -25%
+        mult *= (1.0 - min(skills.mass_production * 0.05, 0.25))
+        # Advanced Mass Production -4% per level → max -20%
+        mult *= (1.0 - min(skills.advanced_mass_production * 0.04, 0.20))
+        # Supply Chain Management -5% per level → max -20%
+        mult *= (1.0 - min(skills.supply_chain_management * 0.05, 0.20))
+        # Implants
+        if body.implants:
+            # Slot 8 implants that reduce build time (e.g. Yeti, Gnome)
+            implant_slot8 = body.implants.get("slot8", "")
+            if implant_slot8 in ("yeti_m4", "gnome_m4"):
+                mult *= 0.99  # -1%
+            # Slot 7 implants that reduce build time
+            implant_slot7 = body.implants.get("slot7", "")
+            if implant_slot7 in ("yeti_m3", "gnome_m3"):
+                mult *= 0.99  # -1%
+            # Slot 10 implant (Hardwiring - Advanced Mass Production)
+            implant_slot10 = body.implants.get("slot10", "")
+            if implant_slot10:
+                mult *= 0.98  # approximate -2%
+        # Rigs (time bonus already computed below)
+        return mult
+
+    # ── Helper: Fetch manufacturing time for a blueprint ──
+    async def _fetch_manuf_time(bp_type_id: int) -> int:
+        sql = text("""
+            SELECT manufacturing_time
+            FROM sde_blueprints
+            WHERE type_id = :bp_id AND activity_id = 1
+            LIMIT 1
+        """)
+        result = await db.execute(sql, {"bp_id": bp_type_id})
+        row = result.fetchone()
+        return row[0] if row and row[0] else 0
+
+    # ── Helper: Fetch materials from SDE ──
+    async def _fetch_materials(bp_type_id: int, me_level: int, te_level: int,
+                                runs: int, rig_mat_bonus: float,
+                                item_config: Optional[FacilityConfig]) -> tuple:
+        """Fetch materials, apply ME, return (materials_list, is_manufacturable, is_reaction)."""
+        sql = text("""
+            SELECT
+                sbm.material_type_id,
+                si.name AS material_name,
+                si.category_id,
+                sbm.quantity AS base_quantity,
+                sbm.is_optional
+            FROM sde_blueprint_materials sbm
+            LEFT JOIN sde_items si ON si.type_id = sbm.material_type_id
+            WHERE sbm.type_id = :bp_id AND sbm.activity_id IN (1, 11)
+        """)
+        result = await db.execute(sql, {"bp_id": bp_type_id})
+        rows = result.all()
+        if not rows:
+            return [], False, False
+
+        # Check if this is a reaction blueprint
+        bp_check = text("""
+            SELECT is_reaction FROM sde_blueprints
+            WHERE type_id = :bp_id AND activity_id IN (1, 11)
+            LIMIT 1
+        """)
+        chk = await db.execute(bp_check, {"bp_id": bp_type_id})
+        bp_info = chk.fetchone()
+        is_reaction = bp_info and bp_info.is_reaction
+
+        materials = []
+        for row in rows:
+            base_qty = row.base_quantity or 0
+            if is_reaction:
+                adjusted = base_qty
+            else:
+                adjusted = base_qty
+                if base_qty > 0:
+                    me_factor = 1.0 - (me_level / 100.0)
+                    adjusted = max(1, math.ceil(base_qty * me_factor * (1.0 - rig_mat_bonus)))
+            total_qty = adjusted * runs
+            materials.append({
+                "material_type_id": row.material_type_id,
+                "material_name": row.material_name or f"Unknown ({row.material_type_id})",
+                "category_id": row.category_id,
+                "base_quantity": base_qty,
+                "adjusted_quantity": adjusted,
+                "total_quantity": total_qty,
+                "is_optional": row.is_optional or False,
+                "is_reaction": is_reaction,
+            })
+
+        return materials, True, is_reaction
+
+    # ── Helper: Calculate job cost ──
+    async def _calc_job_cost(blueprint_type_id: int, runs: int) -> float:
+        """Calculate system cost index job fee for one blueprint type."""
+        # Get base cost from SDE price (or fallback)
+        sql = text("""
+            SELECT sde_price.adjusted_price
+            FROM sde_blueprint_materials sbm
+            JOIN sde_items si ON si.type_id = sbm.material_type_id
+            LEFT JOIN sde_prices ON sde_prices.type_id = sbm.material_type_id
+            WHERE sbm.type_id = :bp_id AND sbm.activity_id IN (1, 11)
+        """)
+        # Simplified: use a percentage of material cost
+        # Actual EVE formula: install fee = material_cost × SCI
+        return 0  # calculated after material cost
+
+    time_mult = _time_multiplier()
+
+    # ── Recursive resolver ──
+    async def _resolve_node(node: OrderItemNode, depth: int,
+                              inherited_facility: FacilityConfig,
+                              rig_mat_bonus: float, rig_time_bonus: float,
+                              time_mult: float) -> CostItemNode:
+        """Recursively resolve one order tree node with costs + time."""
+        result = CostItemNode(
+            blueprint_type_id=node.blueprint_type_id,
+            product_type_id=node.product_type_id,
+            product_name=node.product_name,
+            runs=node.runs,
+            me=node.me,
+            te=node.te,
+            decision=node.decision,
+            buy_price=node.buy_price,
+            depth=depth,
+        )
+
+        # Determine effective config for this node
+        eff_facility = node.config or inherited_facility
+        # system_cost_index is stored as percentage (e.g. 5.0 = 5%), convert to decimal
+        sci = (eff_facility.system_cost_index / 100.0) if eff_facility.system_cost_index is not None else 0.05
+        tax_rate = eff_facility.tax_rate / 100.0 if eff_facility.tax_rate > 0 else 0.035
+        secc_mult = {"highsec": 1.0, "lowsec": 1.9, "null": 2.1, "wh": 2.1}.get(eff_facility.security_class, 1.0)
+
+        if node.decision == "buy":
+            # BUY node — just market price
+            # But still check if it CAN be built (has a manufacturing blueprint)
+            bp_check_sql = text("""
+                SELECT 1 FROM sde_blueprints
+                WHERE type_id = :bp_id AND activity_id = 1
+                LIMIT 1
+            """)
+            bp_chk = await db.execute(bp_check_sql, {"bp_id": node.blueprint_type_id})
+            result.is_buildable = bp_chk.fetchone() is not None
+
+            buy_price = node.buy_price or 0
+            if buy_price == 0 and node.product_type_id:
+                # Look up market price
+                price_sql = text("""
+                    SELECT sell_price_min FROM cached_prices WHERE type_id = :tid LIMIT 1
+                """)
+                pr = await db.execute(price_sql, {"tid": node.product_type_id})
+                p_row = pr.fetchone()
+                if p_row and p_row[0]:
+                    buy_price = p_row[0]
+            total = buy_price * node.runs
+            result.costs.buy_cost = total
+            result.costs.step_total = total
+            result.costs.component_total = total
+            return result
+
+        # BUILD node — fetch materials and calculate
+        result.is_buildable = True
+        mats, is_manuf, is_reaction = await _fetch_materials(
+            node.blueprint_type_id, node.me, node.te, node.runs,
+            rig_mat_bonus, eff_facility,
+        )
+        result.materials = mats
+        result.has_sub_steps = bool(node.sub_components)
+
+        # Fetch manufacturing time
+        manuf_time = await _fetch_manuf_time(node.blueprint_type_id)
+
+        # Calculate material costs
+        mat_cost = 0.0
+        if mats:
+            type_ids = [m["material_type_id"] for m in mats]
+            price_sql = text("""
+                SELECT type_id, sell_price_min, buy_price_max
+                FROM cached_prices
+                WHERE type_id = ANY(:tids)
+            """)
+            price_rows = (await db.execute(price_sql, {"tids": type_ids})).all()
+            price_map = {r[0]: r for r in price_rows}
+
+            for m in mats:
+                tid = m["material_type_id"]
+                pr = price_map.get(tid)
+                if pr:
+                    unit_price = pr[2] if body.use_buy_prices else pr[1]
+                    if unit_price is None:
+                        unit_price = pr[1] or pr[2] or 0
+                else:
+                    unit_price = 0
+                mat_cost += unit_price * m["total_quantity"]
+
+        # Calculate job cost (SCI × base install fee)
+        # Base install fee ≈ material_cost × 0.04 (rough approximation)
+        base_install = mat_cost * 0.04
+        job_cost = base_install * sci * secc_mult
+
+        # Facility tax
+        fac_tax = job_cost * tax_rate
+
+        # SCC surcharge (always 4% of job cost)
+        scc = job_cost * 0.04
+
+        # Build time
+        raw_time = manuf_time
+        adjusted_time = max(1, int(raw_time * time_mult))
+        total_time = adjusted_time * node.runs
+
+        result.costs.material_cost = round(mat_cost, 2)
+        result.costs.job_cost = round(job_cost, 2)
+        result.costs.facility_tax = round(fac_tax, 2)
+        result.costs.scc_surcharge = round(scc, 2)
+        result.costs.step_total = round(mat_cost + job_cost + fac_tax + scc, 2)
+
+        result.time.raw_seconds = raw_time
+        result.time.adjusted_seconds = adjusted_time
+        result.time.total_seconds = total_time
+
+        # Recurse into sub-components
+        sub_total = 0.0
+        sub_time_seq = 0
+        sub_time_par = 0
+        max_depth_reached = depth
+
+        for sub_node in node.sub_components:
+            child = await _resolve_node(
+                sub_node, depth + 1,
+                eff_facility, rig_mat_bonus, rig_time_bonus, time_mult,
+            )
+            result.sub_components.append(child)
+            sub_total += child.costs.component_total
+            sub_time_seq += child.time.total_seconds
+            # Parallel: take max of children at same level
+            if child.time.total_seconds > sub_time_par:
+                sub_time_par = child.time.total_seconds
+            if child.depth > max_depth_reached:
+                max_depth_reached = child.depth
+
+        # Add sub-component costs to this node's total
+        result.costs.component_total = round(result.costs.step_total + sub_total, 2)
+
+        return result
+
+    # ── Resolve rig bonuses ──
+    _RIG_FALLBACK = {"none": 0.0, "t1": 0.02, "t2": 0.024,
+        "t1_reaction": 0.01, "t2_reaction": 0.02}
+    _SEC_MULT = {"highsec": 1.0, "lowsec": 1.9, "null": 2.1, "wh": 2.1}
+    if facility.facility_type == "npc_station":
+        facility.rigs = "none"
+    rig_names = facility.rigs.split(",") if facility.rigs and "," in facility.rigs else [facility.rigs]
+    if rig_names and rig_names != ["none"]:
+        rig_placeholders = ", ".join(f":rid_{i}" for i in range(len(rig_names)))
+        rig_params = {f"rid_{i}": rn for i, rn in enumerate(rig_names)}
+        rig_query = text(f"SELECT rig_id, material_bonus, time_bonus FROM rigs WHERE rig_id IN ({rig_placeholders})")
+        rig_rows = (await db.execute(rig_query, rig_params)).all()
+        rig_mat_db = {r[0]: r[1] for r in rig_rows}
+        rig_time_db = {r[0]: r[2] for r in rig_rows}
+    else:
+        rig_mat_db = {}
+        rig_time_db = {}
+    rig_mat_bonus = sum(
+        rig_mat_db.get(r.strip(), _RIG_FALLBACK.get(r.strip(), 0.0))
+        for r in rig_names
+    ) * _SEC_MULT.get(facility.security_class, 1.0)
+    rig_mat_bonus = min(rig_mat_bonus, 0.10)
+    rig_time_bonus = sum(rig_time_db.get(r.strip(), 0.0) for r in rig_names)
+    rig_time_bonus = min(rig_time_bonus, 0.10)
+
+    # Resolve all top-level items
+    resolved_items = []
+    grand_total = 0.0
+    grand_time_seq = 0
+    grand_time_par = 0
+    max_depth = 0
+
+    for item in body.items:
+        node = await _resolve_node(item, 0, facility, rig_mat_bonus, rig_time_bonus, time_mult)
+        resolved_items.append(node)
+        grand_total += node.costs.component_total
+        grand_time_seq += node.time.total_seconds
+        if node.time.total_seconds > grand_time_par:
+            grand_time_par = node.time.total_seconds
+        if node.depth > max_depth:
+            max_depth = node.depth
+
+    return TreeCostResponse(
+        items=resolved_items,
+        totals=CostBreakdown(component_total=round(grand_total, 2)),
+        total_build_time_seq=grand_time_seq,
+        total_build_time_par=grand_time_par,
+        max_depth=max_depth,
+    )
